# ============================================================
# DD-CLASS 班级管理系统 统一配置（模板）
# 使用方法：复制本文件为 .env，再按实际环境修改各项取值
#   Windows 命令：copy .env.example .env
# 换办公地点 / 局域网 IP 变化时：只需修改 SERVER_IP 一处
# 修改后需重启服务生效（uvicorn --reload 只监视 .py 文件）
# ============================================================

# ---------- 服务器地址（唯一需要按环境修改的项）----------
# 本机在局域网中的 IP（ipconfig 查看 IPv4 地址），用于启动时打印访问提示
SERVER_IP=192.168.1.100

# ---------- 后端服务 ----------
# 监听地址固定 0.0.0.0（允许局域网设备访问），一般无需修改
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# ---------- 主前端（班主任端）----------
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ---------- 家长端前端 ----------
PARENT_HOST=0.0.0.0
PARENT_PORT=5174

# ---------- 数据库（PostgreSQL）----------
# 格式：postgresql://用户名:密码@主机:端口/数据库名
# 需与「部署指南.md 第三章」创建的数据库用户/密码/库名一致
# 注意：密码避免使用 $ 和引号，避免解析歧义
DATABASE_URL=postgresql://ddclass_user:your_password@127.0.0.1:5432/ddclass

# ---------- 安全配置 ----------
# JWT 签名密钥（必填！为空或保留模板默认值时后端会拒绝启动）
# 生成命令：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# 登录令牌有效期（分钟），1440 = 24 小时
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 额外允许的跨域来源（逗号分隔，一般留空）。
# 默认已放行 SERVER_IP/localhost 下两个前端端口；仅浏览器直连后端 API 时才需要填
CORS_ORIGINS=

# ---------- 公网访问（cpolar 内网穿透，临时远程测试用）----------
# 本地/公网启动二选一开关：
#   false = 仅本地/局域网访问（默认，日常使用）
#   true  = 启动后端时自动建立 cpolar 公网隧道，远程用户可访问
# 免费版说明：随机公网地址（每次重启变化）、限速 1Mbps、最多 4 条隧道
# 测试完毕请改回 false 并重启，减少公网暴露时间
PUBLIC_ACCESS=false
# cpolar 官网 https://www.cpolar.com 注册账号，
# 登录 https://dashboard.cpolar.com 在「验证」页复制 authtoken 填到此处
CPOLAR_AUTHTOKEN=
