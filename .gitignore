# ============================================================
# DD-CLASS 班级管理系统 .gitignore
# 适用于同步到个人仓库：排除本地环境、依赖、构建产物与敏感配置
# 注意：.env 排除，但 .env.example（配置模板）必须保留在仓库中
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.installed.cfg
*.egg

# ---------- 虚拟环境（根目录 .venv/ 及各目录下 venv/、env/） ----------
.venv/
venv/
env/
ENV/
.Python

# 历史遗留的旧虚拟环境目录（已删除，防止误提交）
app/dd_class/

# ---------- 测试与静态检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ---------- 环境配置（.env 含 SECRET_KEY/DATABASE_URL，绝不入库） ----------
.env
.env.*
!.env.example

# ---------- 日志与临时文件 ----------
*.log
logs/
*.tmp
*.bak
*.orig
*.py.bak

# ---------- 手工脚本（易产生的一次性调试脚本，防止误入库） ----------
migrate_*.py
fix_*.py
create_*.py
add_*.py
check_*.py
update_*.py
init_*.py
temp_*.py
test_*.py

# ---------- Node ----------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- 构建产物 ----------
dist/
build/
.vite/
frontend/dist/
frontend/.vite/
parent-portal/dist/
parent-portal/.vite/

# ---------- 运行时数据 ----------
uploads/
*.db
*.sqlite
*.sqlite3
*.sql

# ---------- 种子成绩数据（含真实学生姓名与成绩，不公开入库；本地保留）----------
# 克隆者无此文件时 run.py 自动跳过学生/成绩种子；如需自行提供示例数据可放同名文件
七下期末.xlsx

# ---------- cpolar 内网穿透工具（19MB 二进制不入库）----------
# 公网模式需要时从 https://www.cpolar.com/download 下载，放到 tools/cpolar/ 目录即可
tools/cpolar/

# ---------- IDE ----------
.vscode/
.idea/
.vs/
*.swp
*.swo
*~
*.sublime-workspace
*.iml

# ---------- OS ----------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
